NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Stable private secret (32+ characters) for voting-network hashes; keep unchanged during an active tournament.
# Falls back to the service-role key when blank. Raw IP addresses are not stored.
VOTE_RISK_SALT=
# Stable random secret (32+ characters) signing voter cookies; falls back to service-role key.
VOTER_COOKIE_SECRET=
# Optional local Chrome path; Linux deployments use bundled serverless Chromium.
SCREENSHOT_BROWSER_PATH=
# Preview fixtures are only permitted outside NODE_ENV=production.
DEMO_MODE=false
